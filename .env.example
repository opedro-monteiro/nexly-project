# ── Back-end (app/api/.env) ────────────────────────────────────────
PORT="3333"
# Dev local: aponta para localhost
DATABASE_URL="postgresql://nexly:postgres@localhost:5432/nexly-db"

# ── Front-end (app/web/.env) ───────────────────────────────────────
# URL da API consumida pelo browser (dev local e Docker igual)
NEXT_PUBLIC_API_URL=http://localhost:3333
# URL da API consumida pelo servidor Next.js (SSR)
# Dev local: http://localhost:3333
# Docker:    http://api:3333
API_URL=http://localhost:3333
